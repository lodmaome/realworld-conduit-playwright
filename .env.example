# Ports published on the host by docker-compose.
FRONTEND_PORT=4200
BACKEND_PORT=8080

# Reachable from wherever the code that actually calls it executes. Today, both the
# frontend's compiled JS (running in whatever browser loads it) and Playwright's own
# API test fixtures run on the host against docker-compose's published ports, so a
# single value covers both.
#
# If Playwright itself is later containerized on the same compose network (see the
# Docker/CI build-sequence phase), this may need to split into two values: the
# frontend build still needs a browser-reachable URL, while Playwright's own API
# fixtures could move to the internal service address (http://backend:8080/api).
API_BASE_URL=http://localhost:8080/api
FRONTEND_BASE_URL=http://localhost:4200

# Signing key for the backend's JWTs. The pinned backend refuses to start without a real one
# (base64, at least 32 random bytes, no placeholders), so there is no usable default here.
# Generate one per machine and keep it in .env only, never in this file:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SIGNING_KEY=
