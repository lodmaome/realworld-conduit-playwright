{
  "name": "realworld-conduit-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test automation portfolio for the RealWorld (Conduit) app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:regression",
    "test:smoke": "playwright test --grep @smoke --grep-invert @quarantine",
    "test:regression": "playwright test --project=api --project=ui --project=ui-mocked --grep-invert @quarantine",
    "test:full": "node tools/ci/run-all.mjs test:regression test:a11y test:visual",
    "test:quarantine": "playwright test --grep @quarantine --pass-with-no-tests",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:ui-mocked": "playwright test --project=ui-mocked",
    "test:visual": "docker compose --env-file ./.env -f docker/docker-compose.yml run --rm --build playwright npx playwright test --project=visual --grep-invert @quarantine",
    "test:visual:update": "docker compose --env-file ./.env -f docker/docker-compose.yml run --rm --build playwright npx playwright test --project=visual --update-snapshots",
    "test:a11y": "playwright test --project=a11y --grep-invert @quarantine",
    "test:a11y:update": "playwright test --project=a11y --update-snapshots",
    "report": "playwright show-report",
    "allure:generate": "node tools/ci/generate-allure-report.mjs",
    "allure:open": "allure open allure-report",
    "clean:results": "node tools/ci/clean-results.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:tags": "node tools/ci/check-tags.mjs",
    "check:playwright-image": "node tools/ci/check-playwright-image.mjs",
    "check:links": "node tools/ci/check-links.mjs",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "wait-for-app": "node tools/ci/wait-for-app.mjs",
    "generate:api-types": "openapi-typescript http://localhost:8080/swagger/v1/swagger.json -o api-client/schema.d.ts",
    "docker:up": "docker compose --env-file ./.env -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file ./.env -f docker/docker-compose.yml down",
    "docker:logs": "docker compose --env-file ./.env -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "allure": "3.18.0",
    "allure-playwright": "3.12.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
